<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DocFlow.Documentation</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Description>Generates navigable design-documentation bundles (Markdown + Mermaid diagrams) from the DocFlow canonical semantic model.</Description>
    <Authors>Kurt Mitchell</Authors>
    <Company>DocFlow</Company>
    <PackageTags>documentation;openapi;markdown;mermaid;ddd</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocFlow.Core\DocFlow.Core.csproj" />
    <ProjectReference Include="..\DocFlow.Diagrams\DocFlow.Diagrams.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.34.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Html\Assets\theme.css" />
  </ItemGroup>

</Project>
